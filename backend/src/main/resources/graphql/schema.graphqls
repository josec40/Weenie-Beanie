type Query {
    me: User
    "Projection for the next `months` calendar months (1-24), starting after the current month."
    forecast(months: Int = 12): Forecast
    "Posted transactions between two dates (YYYY-MM-DD, inclusive, max 2 years)."
    transactions(from: String!, to: String!): [Transaction!]!
    recurringExpenses: [RecurringExpense!]!
    "Canonical spending categories."
    categories: [String!]!
    "The open micro-loan offer, if any."
    currentOffer: LoanOffer
    loans: [Loan!]!
    creditProfile: CreditProfile!
    "Repayment reputation (mirror of the on-chain credential when Solana is enabled)."
    credential: Credential!
    demoClock: DemoClock!
    notifications(limit: Int = 20): [Notification!]!
    unreadNotifications: Int!
    "Demo tooling state; controls are only enabled for the demo account in dev."
    demoStatus: DemoStatus!
    "Evaluates affordability of a potential purchase and returns a micro-loan proposal if eligible."
    purchaseCheck(amount: Float!, label: String): PurchaseCheckResult!
}

type Subscription {
    loanUpdated: Loan!
    offerCreated: LoanOffer!
    credentialUpdated: Credential!
    balanceUpdated: Balance!
    notificationAdded: Notification!
}

type Notification {
    id: ID!
    "OFFER, LOAN_DISBURSED, LOAN_REPAID, LOAN_DEFAULTED, REPAYMENT_PAUSED, SETTLEMENT_PROBLEM, TIER_UP, TIER_DOWN or BEANSTALK_GREW"
    type: String!
    title: String!
    body: String!
    "In-app route to open, e.g. /loans"
    link: String
    createdAt: String!
    read: Boolean!
}

type Balance {
    balance: Float
    asOf: String!
}

type DemoStatus {
    clock: DemoClock!
    isDemoUser: Boolean!
    "IDLE, RUNNING, DONE or FAILED"
    resetState: String!
    resetMessage: String
    bankAddress: String
    bankUrl: String
    poolUrl: String
    reputationConfigUrl: String
}

type Mutation {
    "Pull new transactions from Nessie for the current user."
    syncTransactions: SyncResult!
    createRecurringExpense(input: RecurringExpenseInput!): RecurringExpense!
    "Returns null if the expense does not exist or belongs to another user."
    updateRecurringExpense(id: ID!, input: RecurringExpenseInput!): RecurringExpense
    deleteRecurringExpense(id: ID!): Boolean!
    "Parse free text (max 500 chars) into unsaved drafts; confirm each with createRecurringExpense."
    draftRecurringExpenses(text: String!): [ExpenseDraft!]!
    "Requires consent = true. Disbursement happens in the offer's shortfall month."
    acceptOffer(offerId: ID!, consent: Boolean!): Loan!
    declineOffer(offerId: ID!): Boolean!
    "Move repayment one month later (once, within the repayment window)."
    rescheduleLoan(loanId: ID!): Loan!
    "Repay now instead of the scheduled month (balance safeguard still applies)."
    repayLoanEarly(loanId: ID!): Loan!
    "Demo only: close the current simulated month and open the next."
    advanceMonth: DemoClock!
    "Demo only: wipe and re-seed the demo account in the background; poll demoStatus for progress."
    resetDemo: DemoStatus!
    "Marks the given notifications read; an empty or missing list marks all. Returns how many changed."
    markNotificationsRead(ids: [ID!]): Int!
    "Accept a micro-loan to fund a purchase. Immediate disbursement and on-chain vendor settlement."
    acceptPurchaseLoan(amount: Float!, label: String, consent: Boolean!, expectedTotalDue: Float!, merchantId: String): Loan!
    "Directly purchase from a merchant using available checking account balance."
    payMerchant(merchantId: String!, amount: Float!, description: String): Boolean!
}

type LoanOffer {
    id: ID!
    "YYYY-MM: month the money is disbursed"
    shortfallMonth: String!
    "YYYY-MM: month principal + fee is auto-drafted"
    repaymentMonth: String!
    deficit: Float!
    principal: Float!
    fee: Float!
    projectedSurplus: Float!
    status: String!
    purpose: String!
    purchaseLabel: String
    purchaseAmount: Float
    explanation: String
    createdAt: String!
}

enum LoanStatus {
    ACCEPTED
    DISBURSING
    ACTIVE
    REPAYING
    LATE
    REPAID
    DEFAULTED
}

type Loan {
    id: ID!
    status: LoanStatus!
    principal: Float!
    fee: Float!
    totalDue: Float!
    disburseMonth: String!
    repayMonth: String!
    graceUntilMonth: String
    rescheduleCount: Int!
    lastFailure: String
    "Nessie transfer ids of the fiat legs"
    nessieDepositId: String
    nessieWithdrawalId: String
    "Solana transaction signatures of the escrow legs (null in fiat-only mode)"
    solanaDisburseSignature: String
    solanaRepaySignature: String
    disburseTxUrl: String
    repayTxUrl: String
    purpose: String!
    purchaseLabel: String
    purchaseAmount: Float
    payeeMerchantId: String
    solanaVendorSignature: String
    vendorTxUrl: String
    createdAt: String!
    updatedAt: String!
}

type CreditProfile {
    tier: Int!
    cap: Float!
    "OFFER_AVAILABLE, HAS_OPEN_LOAN, NO_SHORTFALL, EXCEEDS_TIER_CAP or NO_REPAYMENT_MONTH"
    offerStatus: String!
}

type Credential {
    onChain: Boolean!
    tier: Int!
    cap: Float!
    "Effective on-time repayments needed for the next tier; null at the top tier"
    nextTierAt: Int
    "On-time repayments minus two per default"
    effectiveOnTime: Int!
    onTimeRepayments: Int!
    lateRepayments: Int!
    defaults: Int!
    totalRepaid: Float!
    walletAddress: String
    walletUrl: String
    "Soulbound token mint; null until the first on-time repayment"
    credentialMint: String
    credentialUrl: String
    credentialTxUrl: String
    "Public, unauthenticated verification endpoint for partners"
    verifyUrl: String
}

type DemoClock {
    "YYYY-MM"
    currentMonth: String!
    offset: Int!
    enabled: Boolean!
}

type SyncResult {
    fetched: Int!
    inserted: Int!
}

type User {
    id: ID!
    email: String!
    nessieCustomerId: String
    nessieCheckingAccountId: String
}

type Forecast {
    "YYYY-MM"
    currentMonth: String!
    startingBalance: Float!
    "ISO-8601 time of the balance snapshot the projection starts from; null if never synced."
    balanceAsOf: String
    discretionaryMonthly: Float!
    months: [ForecastMonth!]!
    "Plain-language summary (Gemini, cached; deterministic fallback)."
    explanation: Explanation!
}

enum AiSource {
    AI
    FALLBACK
    RULES
}

type Explanation {
    text: String!
    source: AiSource!
}

type ExpenseDraft {
    name: String!
    amount: Float!
    category: String!
    dayOfMonth: Int!
    "YYYY-MM"
    startMonth: String!
    durationMonths: Int
    source: AiSource!
}

type ForecastMonth {
    "YYYY-MM"
    month: String!
    income: Float!
    expenses: Float!
    net: Float!
    endingBalance: Float!
    "Ending balance is below zero."
    shortfall: Boolean!
    lines: [ForecastLine!]!
}

type ForecastLine {
    label: String!
    category: String!
    "Signed: inflow > 0, outflow < 0."
    amount: Float!
    source: ForecastSource!
}

enum ForecastSource {
    MONTHLY
    BIWEEKLY
    WEEKLY
    ANNUAL
    RECURRING_EXPENSE
    DISCRETIONARY
    LOAN
}

type Transaction {
    id: ID!
    "YYYY-MM-DD"
    date: String!
    kind: String!
    "Signed: inflow > 0, outflow < 0."
    amount: Float!
    category: String!
    description: String
}

type RecurringExpense {
    id: ID!
    name: String!
    amount: Float!
    category: String!
    dayOfMonth: Int!
    "YYYY-MM"
    startMonth: String!
    "Null means open-ended."
    durationMonths: Int
    "Last month with a payment (YYYY-MM); null if open-ended."
    endMonth: String
}

input RecurringExpenseInput {
    name: String!
    amount: Float!
    category: String!
    "1-28"
    dayOfMonth: Int!
    "YYYY-MM"
    startMonth: String!
    durationMonths: Int
}

enum PurchaseVerdict {
    AFFORDABLE
    LOAN_AVAILABLE
    NOT_ELIGIBLE
}

type PurchaseCheckResult {
    verdict: PurchaseVerdict!
    reason: String
    balanceNow: Float!
    gapToday: Float!
    proposal: PurchaseProposal
    affordableFrom: String
    laterShortfallMonth: String
    months: [ForecastMonth!]!
    explanation: Explanation
}

type PurchaseProposal {
    principal: Float!
    fee: Float!
    repaymentMonth: String!
    totalDue: Float!
}

