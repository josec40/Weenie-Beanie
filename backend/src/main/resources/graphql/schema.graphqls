type Query {
    me: User
    "Projection for the next `months` calendar months (1-24), starting after the current month."
    forecast(months: Int = 12): Forecast
    "Posted transactions between two dates (YYYY-MM-DD, inclusive, max 2 years)."
    transactions(from: String!, to: String!): [Transaction!]!
    recurringExpenses: [RecurringExpense!]!
    "Canonical spending categories."
    categories: [String!]!
    "The open micro-loan offer, if any."
    currentOffer: LoanOffer
    loans: [Loan!]!
    creditProfile: CreditProfile!
    demoClock: DemoClock!
}

type Mutation {
    "Pull new transactions from Nessie for the current user."
    syncTransactions: SyncResult!
    createRecurringExpense(input: RecurringExpenseInput!): RecurringExpense!
    "Returns null if the expense does not exist or belongs to another user."
    updateRecurringExpense(id: ID!, input: RecurringExpenseInput!): RecurringExpense
    deleteRecurringExpense(id: ID!): Boolean!
    "Parse free text (max 500 chars) into unsaved drafts; confirm each with createRecurringExpense."
    draftRecurringExpenses(text: String!): [ExpenseDraft!]!
    "Requires consent = true. Disbursement happens in the offer's shortfall month."
    acceptOffer(offerId: ID!, consent: Boolean!): Loan!
    declineOffer(offerId: ID!): Boolean!
    "Move repayment one month later (once, within the repayment window)."
    rescheduleLoan(loanId: ID!): Loan!
    "Repay now instead of the scheduled month (balance safeguard still applies)."
    repayLoanEarly(loanId: ID!): Loan!
    "Demo only: close the current simulated month and open the next."
    advanceMonth: DemoClock!
}

type LoanOffer {
    id: ID!
    "YYYY-MM: month the money is disbursed"
    shortfallMonth: String!
    "YYYY-MM: month principal + fee is auto-drafted"
    repaymentMonth: String!
    deficit: Float!
    principal: Float!
    fee: Float!
    projectedSurplus: Float!
    status: String!
    explanation: String
    createdAt: String!
}

enum LoanStatus {
    ACCEPTED
    DISBURSING
    ACTIVE
    REPAYING
    LATE
    REPAID
    DEFAULTED
}

type Loan {
    id: ID!
    status: LoanStatus!
    principal: Float!
    fee: Float!
    totalDue: Float!
    disburseMonth: String!
    repayMonth: String!
    graceUntilMonth: String
    rescheduleCount: Int!
    lastFailure: String
    "Nessie transfer ids of the fiat legs"
    nessieDepositId: String
    nessieWithdrawalId: String
    "Solana transaction signatures of the escrow legs (null in fiat-only mode)"
    solanaDisburseSignature: String
    solanaRepaySignature: String
    disburseTxUrl: String
    repayTxUrl: String
    createdAt: String!
    updatedAt: String!
}

type CreditProfile {
    tier: Int!
    cap: Float!
    "OFFER_AVAILABLE, HAS_OPEN_LOAN, NO_SHORTFALL, EXCEEDS_TIER_CAP or NO_REPAYMENT_MONTH"
    offerStatus: String!
}

type DemoClock {
    "YYYY-MM"
    currentMonth: String!
    offset: Int!
    enabled: Boolean!
}

type SyncResult {
    fetched: Int!
    inserted: Int!
}

type User {
    id: ID!
    email: String!
    nessieCustomerId: String
    nessieCheckingAccountId: String
}

type Forecast {
    "YYYY-MM"
    currentMonth: String!
    startingBalance: Float!
    "ISO-8601 time of the balance snapshot the projection starts from; null if never synced."
    balanceAsOf: String
    discretionaryMonthly: Float!
    months: [ForecastMonth!]!
    "Plain-language summary (Gemini, cached; deterministic fallback)."
    explanation: Explanation!
}

enum AiSource {
    AI
    FALLBACK
    RULES
}

type Explanation {
    text: String!
    source: AiSource!
}

type ExpenseDraft {
    name: String!
    amount: Float!
    category: String!
    dayOfMonth: Int!
    "YYYY-MM"
    startMonth: String!
    durationMonths: Int
    source: AiSource!
}

type ForecastMonth {
    "YYYY-MM"
    month: String!
    income: Float!
    expenses: Float!
    net: Float!
    endingBalance: Float!
    "Ending balance is below zero."
    shortfall: Boolean!
    lines: [ForecastLine!]!
}

type ForecastLine {
    label: String!
    category: String!
    "Signed: inflow > 0, outflow < 0."
    amount: Float!
    source: ForecastSource!
}

enum ForecastSource {
    MONTHLY
    BIWEEKLY
    WEEKLY
    ANNUAL
    RECURRING_EXPENSE
    DISCRETIONARY
    LOAN
}

type Transaction {
    id: ID!
    "YYYY-MM-DD"
    date: String!
    kind: String!
    "Signed: inflow > 0, outflow < 0."
    amount: Float!
    category: String!
    description: String
}

type RecurringExpense {
    id: ID!
    name: String!
    amount: Float!
    category: String!
    dayOfMonth: Int!
    "YYYY-MM"
    startMonth: String!
    "Null means open-ended."
    durationMonths: Int
    "Last month with a payment (YYYY-MM); null if open-ended."
    endMonth: String
}

input RecurringExpenseInput {
    name: String!
    amount: Float!
    category: String!
    "1-28"
    dayOfMonth: Int!
    "YYYY-MM"
    startMonth: String!
    durationMonths: Int
}
