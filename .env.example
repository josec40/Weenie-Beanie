# Copy to .env (never commit .env). Loaded by the backend via spring.config.import.

# Tiger Cloud: convert `tiger db uri` (postgres://user:pass@host:port/tsdb?sslmode=require) to JDBC form
DB_URL=jdbc:postgresql://<host>:<port>/tsdb?sslmode=require
DB_USER=tsdbadmin
DB_PASSWORD=

KAFKA_BOOTSTRAP=localhost:9092

NESSIE_BASE_URL=http://api.nessieisreal.com
NESSIE_API_KEY=

GEMINI_API_KEY=

# At least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=

DEMO_USER_EMAIL=alex@demo.local
DEMO_USER_PASSWORD=
