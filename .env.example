# Copy to .env (repo root) and fill in. The backend loads ./.env and ../.env automatically.

# Tiger Cloud (PostgreSQL + TimescaleDB)
DB_URL=jdbc:postgresql://<host>:<port>/tsdb?sslmode=require
DB_USER=
DB_PASSWORD=

# Kafka (infra/docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:9092

# Capital One Nessie sandbox
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_API_KEY=

# Google Gemini (optional; template fallbacks are used without it)
GEMINI_API_KEY=
GEMINI_MODEL=

# Auth: HS256 secret, at least 32 bytes
JWT_SECRET=

# Demo account seeded in the dev profile
DEMO_USER_EMAIL=alex@demo.local
DEMO_USER_PASSWORD=

# AES-GCM key (base64, 32 bytes) for custodial devnet wallets: openssl rand -base64 32
WALLET_MASTER_KEY=

# Optional Solana overrides (defaults target the deployed devnet programs)
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_BANK_KEYPAIR=~/.config/solana/shbean-bank.json
