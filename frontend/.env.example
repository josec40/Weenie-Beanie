# Optional: URL of the hosted Spring Boot backend.
# If omitted or left blank in local development, requests route through the Vite proxy (http://localhost:8090).
# In production on Vercel, set this to your hosted backend (e.g., https://api.weenie-beanie.garden).
VITE_API_BASE_URL=

# Optional: URL of the WebSocket endpoint for GraphQL subscriptions.
# Defaults to VITE_API_BASE_URL converted to wss://.../graphql-ws if unset.
VITE_WS_URL=
